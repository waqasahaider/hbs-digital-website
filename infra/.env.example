# ------------------------------------------------------------
# Copy this file to `.env` ON THE SERVER and fill in real values:
#     cp .env.example .env && nano .env
# NEVER commit .env — it is gitignored. Secrets live only on the VPS.
# ------------------------------------------------------------

# The site's domain (apex, no scheme, no www)
SITE_DOMAIN=hbsdigital.ae

# Email Let's Encrypt uses for cert expiry notices
ACME_EMAIL=admin@hbsdigital.ae

# ---- Future: n8n (only needed when you enable services/n8n.yml) ----
# N8N_DOMAIN=n8n.hbsdigital.ae
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password
# N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# GENERIC_TIMEZONE=Asia/Dubai
